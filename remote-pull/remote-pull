#!/usr/bin/env bash
#ddev-generated
# Worker of the remote-pull add-on. The providers in .ddev/providers/ (ddev pull <source>) and the host command
# "ddev remote-pull" call it, always on the host and from the project root:
#
#   remote-pull <action> <source>
#
# Actions used by the providers: info, auth, db, import, files.
# Actions of "ddev remote-pull": sizes, check, sources.
#
# Settings come from .ddev/remote-pull/config (committed) and .ddev/remote-pull/config.local (personal, ignored by
# git), INI files with one [section] per source. A few of them can be set for one run with
# "ddev pull <source> --environment=NAME=value", see OVERRIDABLE.
#
# Runs on the host and stays compatible with bash 3.2 (macOS). Nothing here writes to the remote server: the remote
# commands are mysql (SELECT on information_schema), mysqldump and rsync as sender.

set -o nounset -o pipefail
# table patterns like cache_* must never expand to local file names
set -f

ADDON_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="${DDEV_APPROOT:-$(cd "$ADDON_DIR/../.." && pwd)}"
PROJECT_NAME="${DDEV_SITENAME:-$(basename "$PROJECT_ROOT")}"
DOWNLOAD_DIR="$PROJECT_ROOT/.ddev/.downloads"

# settings that "--environment=NAME=value" of ddev pull may override for one run
OVERRIDABLE="EMPTY_TABLES WITH_DATA ALL_DATA BACKUP DRY_RUN FILES_DELETE"

die() {
  echo "remote-pull: $*" >&2
  exit 1
}

# ---------------------------------------------------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------------------------------------------------

STEP_START=0
step() {
  echo "==> $*"
  STEP_START=$SECONDS
}
step_done() {
  local s=$((SECONDS - STEP_START))
  printf '    done in %dm %02ds\n' $((s / 60)) $((s % 60))
}

# ---------------------------------------------------------------------------------------------------------------------
# configuration
# ---------------------------------------------------------------------------------------------------------------------

# Settings of a source, from its section or the defaults before the first section
SOURCE_KEYS="ssh port ssh_key db mysql_defaults root files files_exclude empty_tables with_data dump_options backup files_delete"
# settings only allowed before the first section
DEFAULT_KEYS="dump_dir"

is_yes() {
  case "${1:-}" in
    1|y|Y|yes|YES|true|TRUE) return 0 ;;
    *) return 1 ;;
  esac
}

# names go into a remote shell command line: allow nothing but [A-Za-z0-9_]
is_safe_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_]*) return 1 ;;
    *) return 0 ;;
  esac
}

# paths go into a remote shell command line as well; no spaces, no quotes, no ".."
is_safe_path() {
  case "$1" in
    ''|*[!A-Za-z0-9_./~@+-]*|*..*) return 1 ;;
    *) return 0 ;;
  esac
}

# Reads an INI file: "key = value" lines, [section] headers, comments with # or ; at the start of a line.
# Prints "<section><TAB><key><TAB><value>" per setting, "*" as section for the defaults before the first header and a
# "<section><TAB>-<TAB>" line per header, so a section without settings still counts as a source. Values may be
# quoted with "..." or '...'. The file is only read, never executed.
parse_ini() {
  awk -v file="${1#"$PROJECT_ROOT"/}" -v source_keys=" $SOURCE_KEYS " -v default_keys=" $DEFAULT_KEYS " '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    function fail(msg) { printf "%s:%d: %s\n", file, NR, msg > "/dev/stderr"; bad = 1 }
    BEGIN { section = "*" }
    { line = trim($0) }
    line == "" || line ~ /^[#;]/ { next }
    line ~ /^\[.*\]$/ {
      section = trim(substr(line, 2, length(line) - 2))
      if (section !~ /^[A-Za-z0-9_]+$/) fail("invalid section name [" section "], use letters, digits and _")
      print section "\t-\t"
      next
    }
    {
      eq = index(line, "=")
      if (eq == 0) { fail("expected \"key = value\": " line); next }
      key = tolower(trim(substr(line, 1, eq - 1)))
      value = trim(substr(line, eq + 1))
      if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) value = substr(value, 2, length(value) - 2)
      if (index(value, "\t")) { fail("tab in the value of " key); next }
      if (index(source_keys, " " key " ")) { print section "\t" key "\t" value; next }
      if (index(default_keys, " " key " ")) {
        if (section == "*") print section "\t" key "\t" value
        else fail(key " belongs before the first section")
        next
      }
      fail("unknown setting \"" key "\"")
    }
    END { exit bad }
  ' "$1"
}

# value of <key> in <section>; prints it and succeeds when the key is there, also with an empty value.
# The last match wins, so config.local, read after config, beats it.
config_get() {
  local want_section="$1" want_key="$2" section key value found=1 result=""
  while IFS=$'\t' read -r section key value; do
    if [ "$section" = "$want_section" ] && [ "$key" = "$want_key" ]; then
      result="$value"
      found=0
    fi
  done <<< "$CONFIG"
  [ "$found" -eq 0 ] && printf '%s' "$result"
  return "$found"
}

# names given with "ddev pull --environment", see OVERRIDABLE
is_overridden() {
  case " $OVERRIDE_NAMES " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# value of <key> for $SOURCE: run-time override <ENV_NAME>, the section of the source, the defaults, <default>
setting() {
  local key="$1" env_name="${2:-}" default="${3:-}"
  if [ -n "$env_name" ] && is_overridden "$env_name"; then
    printf '%s' "${!env_name}"
    return
  fi
  config_get "$SOURCE" "$key" || config_get "*" "$key" || printf '%s' "$default"
}

load_config() {
  local parsed
  [ -f "$ADDON_DIR/config" ] || die "no configuration: copy .ddev/remote-pull/config.dist to .ddev/remote-pull/config and fill in the sources"
  parsed="$(parse_ini "$ADDON_DIR/config")" || die "fix .ddev/remote-pull/config first"
  CONFIG="$parsed"
  if [ -f "$ADDON_DIR/config.local" ]; then
    parsed="$(parse_ini "$ADDON_DIR/config.local")" || die "fix .ddev/remote-pull/config.local first"
    CONFIG="$CONFIG"$'\n'"$parsed"
  fi

  # sections in the order of their first appearance
  SOURCES=""
  local section key value
  while IFS=$'\t' read -r section key value; do
    [ -n "$section" ] && [ "$section" != "*" ] || continue
    case " $SOURCES " in *" $section "*) ;; *) SOURCES="${SOURCES:+$SOURCES }$section" ;; esac
  done <<< "$CONFIG"

  DUMP_DIR="$(config_get "*" dump_dir || true)"
  DUMP_DIR="${DUMP_DIR:-$HOME/ddev-remote-pull/$PROJECT_NAME}"
  case "$DUMP_DIR" in "~/"*) DUMP_DIR="$HOME/${DUMP_DIR#\~/}" ;; esac
  # only run-time options, not part of the config files
  ALL_DATA="${ALL_DATA:-0}"
  DRY_RUN="${DRY_RUN:-0}"
}

# reads and validates the settings of $SOURCE
load_source() {
  is_safe_name "$SOURCE" || die "invalid source name: $SOURCE"
  case " $SOURCES " in
    *" $SOURCE "*) ;;
    *) die "no section [$SOURCE] in .ddev/remote-pull/config (sections: ${SOURCES:-none})" ;;
  esac

  SSH_TARGET="$(setting ssh)"
  SSH_PORT="$(setting port)"
  SSH_KEY_USED="$(setting ssh_key)"
  # personal key from the shell profile, beats both config files
  [ -n "${REMOTE_PULL_SSH_KEY:-}" ] && SSH_KEY_USED="$REMOTE_PULL_SSH_KEY"
  REMOTE_DB="$(setting db)"
  MYSQL_DEFAULTS="$(setting mysql_defaults)"
  REMOTE_ROOT="$(setting root)"
  FILES="$(setting files)"
  FILES_EXCLUDE="$(setting files_exclude)"
  DUMP_OPTIONS="$(setting dump_options)"
  EMPTY_TABLES="$(setting empty_tables EMPTY_TABLES)"
  WITH_DATA="$(setting with_data WITH_DATA)"
  BACKUP="$(setting backup BACKUP 1)"
  FILES_DELETE="$(setting files_delete FILES_DELETE 0)"

  [ -n "$SSH_TARGET" ] || die "ssh is not set in [$SOURCE] (user@host or a Host of ~/.ssh/config)"
  case "$SSH_TARGET" in
    -*|*[!A-Za-z0-9_.@-]*) die "invalid ssh in [$SOURCE]: $SSH_TARGET" ;;
  esac
  if [ -n "$SSH_PORT" ]; then
    case "$SSH_PORT" in *[!0-9]*) die "invalid port in [$SOURCE]: $SSH_PORT" ;; esac
  fi
  [ -z "$REMOTE_DB" ] || is_safe_name "$REMOTE_DB" || die "invalid db in [$SOURCE]: $REMOTE_DB"
  [ -z "$MYSQL_DEFAULTS" ] || is_safe_path "$MYSQL_DEFAULTS" || die "invalid mysql_defaults in [$SOURCE]: $MYSQL_DEFAULTS"
  [ -z "$REMOTE_ROOT" ] || is_safe_path "$REMOTE_ROOT" || die "invalid root in [$SOURCE]: $REMOTE_ROOT"
  # dump_options go into the remote command line unquoted: options only, no shell syntax
  case "$DUMP_OPTIONS" in
    *[!A-Za-z0-9_=,.\ -]*) die "invalid dump_options in [$SOURCE]: $DUMP_OPTIONS" ;;
  esac

  case "$SSH_KEY_USED" in "~/"*) SSH_KEY_USED="$HOME/${SSH_KEY_USED#\~/}" ;; esac

  # no terminal for the providers: a password or passphrase prompt would hang, so fail instead.
  # With a key: offer that key only, even if the agent holds more.
  SSH_OPTS=(-o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no)
  [ -n "$SSH_PORT" ] && SSH_OPTS+=(-p "$SSH_PORT")
  if [ -n "$SSH_KEY_USED" ]; then
    [ -f "$SSH_KEY_USED" ] || die "SSH key not found: $SSH_KEY_USED (ssh_key or REMOTE_PULL_SSH_KEY)"
    SSH_OPTS+=(-i "$SSH_KEY_USED" -o IdentitiesOnly=yes -o PreferredAuthentications=publickey)
  fi

  # the remote shell does not expand ~ after "=", so a leading ~/ becomes $HOME/
  MYSQL_OPT=""
  case "$MYSQL_DEFAULTS" in
    "") ;;
    "~/"*) MYSQL_OPT="--defaults-extra-file=\$HOME/${MYSQL_DEFAULTS#\~/}" ;;
    *) MYSQL_OPT="--defaults-extra-file=$MYSQL_DEFAULTS" ;;
  esac
}

remote() {
  ssh "${SSH_OPTS[@]}" "$SSH_TARGET" "$@"
}

describe_source() {
  local where="$SSH_TARGET"
  [ -n "$SSH_PORT" ] && where="$where:$SSH_PORT"
  printf '%s (%s' "$SOURCE" "$where"
  [ -n "$REMOTE_DB" ] && printf ', database %s' "$REMOTE_DB"
  printf ')'
}

# ---------------------------------------------------------------------------------------------------------------------
# tables
# ---------------------------------------------------------------------------------------------------------------------

matches_any() {
  local name="$1" pattern
  shift
  for pattern in "$@"; do
    # unquoted on purpose: pattern match, not string comparison
    # shellcheck disable=SC2254
    case "$name" in $pattern) return 0 ;; esac
  done
  return 1
}

# structure only = matches the empty list and is not wanted with rows
is_emptied() {
  # shellcheck disable=SC2086
  matches_any "$1" $EMPTY_LIST && ! matches_any "$1" $WITH_LIST
}

add_mb() {
  awk -v a="$1" -v b="$2" 'BEGIN { print a + b }'
}

# reads the table list of the remote database and sorts it into EMPTIED and the sizes
resolve_tables() {
  local query table mb rows mark pattern found
  [ -n "$REMOTE_DB" ] || die "db is not set in [$SOURCE]"

  EMPTY_LIST="${EMPTY_TABLES//,/ }"
  WITH_LIST="${WITH_DATA//,/ }"
  is_yes "$ALL_DATA" && EMPTY_LIST=""

  query="SELECT table_name, ROUND((data_length + index_length) / 1048576, 1), table_rows FROM information_schema.TABLES WHERE table_schema = '$REMOTE_DB' AND table_type = 'BASE TABLE' ORDER BY data_length + index_length DESC"
  step "Reading the tables of '$REMOTE_DB' from $SSH_TARGET ..."
  if ! TABLES="$(remote "mysql $MYSQL_OPT -N -B -e \"$query\"")" || [ -z "$TABLES" ]; then
    die "could not read the tables of '$REMOTE_DB' on $SSH_TARGET (database name, credentials on the server, see README)"
  fi
  step_done

  EMPTIED=""
  EMPTIED_MB=0
  KEPT_MB=0
  SIZE_REPORT=""
  while IFS=$'\t' read -r table mb rows; do
    [ -n "$table" ] || continue
    is_safe_name "$table" || die "unexpected table name on $SOURCE: $table"
    if is_emptied "$table"; then
      EMPTIED="$EMPTIED $table"
      EMPTIED_MB="$(add_mb "$EMPTIED_MB" "$mb")"
      mark="structure only"
    else
      KEPT_MB="$(add_mb "$KEPT_MB" "$mb")"
      mark=""
    fi
    SIZE_REPORT="$SIZE_REPORT$(printf '%10s MB %12s rows  %-40s %s' "$mb" "$rows" "$table" "$mark")"$'\n'
  done <<< "$TABLES"

  # a pattern without a match is no error: the same list serves projects and sources with other tables
  for pattern in $EMPTY_LIST; do
    found=0
    while IFS=$'\t' read -r table mb rows; do
      # shellcheck disable=SC2254
      case "$table" in $pattern) found=1; break ;; esac
    done <<< "$TABLES"
    [ "$found" = 1 ] || echo "    note: empty_tables entry '$pattern' matches no table on $SOURCE"
  done
}

# ---------------------------------------------------------------------------------------------------------------------
# dumps
# ---------------------------------------------------------------------------------------------------------------------

# A complete dump ends every mysqldump run with "-- Dump completed". One pass only: the exit status of gzip tells
# whether the file is intact, grep -c counts the finished parts (it exits 1 for zero, so its status is not used).
check_dump() {
  local file="$1" expected="$2" count rc
  step "Checking the dump ($(du -h "$file" | cut -f1) compressed) ..."
  count="$(gzip -dc "$file" 2>/dev/null | grep -c '^-- Dump completed'; exit "${PIPESTATUS[0]}")"
  rc=$?
  [ "$rc" -eq 0 ] || { echo "remote-pull: the dump is not a valid gzip file: $file" >&2; return 1; }
  if [ "${count:-0}" -lt "$expected" ]; then
    echo "remote-pull: the dump is incomplete ($count of $expected parts finished): $file" >&2
    return 1
  fi
  step_done
}

PART_FILE=""
cleanup_part() {
  [ -n "$PART_FILE" ] && rm -f "$PART_FILE"
}

action_db() {
  local stamp file dump_opts ignore table remote_cmd parts
  resolve_tables

  echo "    with rows:      $KEPT_MB MB (data and index on $SOURCE)"
  if [ -n "$EMPTIED" ]; then
    echo "    structure only: $EMPTIED_MB MB -$EMPTIED"
  else
    echo "    structure only: none"
  fi

  mkdir -p "$DUMP_DIR" || die "cannot create $DUMP_DIR"
  stamp="$(date +%Y%m%d-%H%M%S)"
  file="$DUMP_DIR/$SOURCE--$stamp.sql.gz"

  dump_opts="--single-transaction --quick --no-tablespaces --default-character-set=utf8mb4 $DUMP_OPTIONS"
  if [ -n "$EMPTIED" ]; then
    ignore=""
    for table in $EMPTIED; do ignore="$ignore --ignore-table=$REMOTE_DB.$table"; done
    remote_cmd="{ mysqldump $MYSQL_OPT $dump_opts$ignore $REMOTE_DB && mysqldump $MYSQL_OPT --no-data --no-tablespaces $REMOTE_DB$EMPTIED; } | gzip -c"
    parts=2
  else
    remote_cmd="mysqldump $MYSQL_OPT $dump_opts $REMOTE_DB | gzip -c"
    parts=1
  fi

  step "Fetching the dump (mysqldump on $SOURCE, compressed transfer, no progress shown) ..."
  PART_FILE="$file.part"
  # remove the partial file on every abort, Ctrl-C included
  trap cleanup_part EXIT INT TERM
  remote "$remote_cmd" > "$PART_FILE" || die "fetching the dump failed, nothing was changed locally"
  step_done
  check_dump "$PART_FILE" "$parts" || exit 1
  mv "$PART_FILE" "$file"
  PART_FILE=""
  trap - EXIT INT TERM
  echo "    saved: $file"

  # ddev pull expects the dump in .ddev/.downloads. A symlink keeps large dumps out of the project folder and so out
  # of a Mutagen sync; the import action reads the target.
  mkdir -p "$DOWNLOAD_DIR"
  ln -sf "$file" "$DOWNLOAD_DIR/db.sql.gz"
}

action_import() {
  local file stamp backup
  file="$DOWNLOAD_DIR/db.sql.gz"
  [ -L "$file" ] && file="$(readlink "$file")"
  [ -f "$file" ] || die "no dump to import: $DOWNLOAD_DIR/db.sql.gz"

  if is_yes "$BACKUP"; then
    mkdir -p "$DUMP_DIR" || die "cannot create $DUMP_DIR"
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="$DUMP_DIR/local--$stamp.sql.gz"
    step "Backing up the local database (no progress shown) ..."
    ddev export-db --gzip --file="$backup" || die "the backup failed, the local database was not changed"
    step_done
    echo "    saved: $backup ($(du -h "$backup" | cut -f1))"
  else
    echo "    no backup of the local database (backup = 0)"
  fi

  # ddev pull runs pre-import-db and post-import-db around this action, so the nested import skips them
  step "Importing $file (drops the local database first) ..."
  ddev import-db --skip-hooks --no-progress --file="$file" || die "the import failed"
  step_done
}

# ---------------------------------------------------------------------------------------------------------------------
# files
# ---------------------------------------------------------------------------------------------------------------------

action_files() {
  local path opts pattern rsh
  if [ -z "$FILES" ]; then
    echo "    no files configured for [$SOURCE], no files pulled"
    return 0
  fi
  [ -n "$REMOTE_ROOT" ] || die "root is not set in [$SOURCE] (project root on the server)"
  command -v rsync >/dev/null 2>&1 || die "rsync is not installed on this computer"

  # rsync takes the ssh options as one string
  rsh="ssh"
  for opt in "${SSH_OPTS[@]}"; do rsh="$rsh $opt"; done

  opts=(-rlptz --human-readable --stats -e "$rsh")
  # GNU rsync can show the overall progress, the openrsync of macOS cannot
  rsync --info=progress2 --version >/dev/null 2>&1 && opts+=(--info=progress2)
  is_yes "$FILES_DELETE" && opts+=(--delete)
  is_yes "$DRY_RUN" && opts+=(--dry-run --itemize-changes)
  for pattern in $FILES_EXCLUDE; do opts+=(--exclude="$pattern"); done

  for path in $FILES; do
    path="${path%/}"
    case "$path" in /*) die "files are relative to the project root: $path" ;; esac
    is_safe_path "$path" || die "invalid entry in files: $path"
    mkdir -p "$PROJECT_ROOT/$path"
    step "rsync $SOURCE:$REMOTE_ROOT/$path/ -> $path/$(is_yes "$DRY_RUN" && echo ' (dry run, nothing changed)')"
    rsync "${opts[@]}" "$SSH_TARGET:$REMOTE_ROOT/$path/" "$PROJECT_ROOT/$path/" || die "rsync of $path failed"
    step_done
  done
}

# ---------------------------------------------------------------------------------------------------------------------
# remote-pull command
# ---------------------------------------------------------------------------------------------------------------------

action_sizes() {
  resolve_tables
  echo
  echo "Tables of '$REMOTE_DB' on $SOURCE (data and index):"
  printf '%s' "$SIZE_REPORT"
  echo
  echo "With rows: $KEPT_MB MB, structure only: $EMPTIED_MB MB"
}

action_check() {
  local ok=0 path
  echo "Source $(describe_source)"
  [ -n "$SSH_KEY_USED" ] && echo "  key:   $SSH_KEY_USED" || echo "  key:   from ssh-agent or ~/.ssh/config"

  if remote true; then
    echo "  [OK]   ssh login"
  else
    echo "  [FAIL] ssh login without a prompt failed. A key with passphrase has to be in the ssh-agent (ssh-add)."
    return 1
  fi

  if [ -n "$REMOTE_DB" ]; then
    if remote "mysql $MYSQL_OPT -N -B -e \"SELECT COUNT(*) FROM information_schema.TABLES WHERE table_schema = '$REMOTE_DB'\"" | grep -q '^[1-9]'; then
      echo "  [OK]   database $REMOTE_DB readable"
    else
      echo "  [FAIL] database $REMOTE_DB not readable (credentials on the server, see README)"
      ok=1
    fi
    remote "command -v mysqldump >/dev/null && command -v gzip >/dev/null" \
      && echo "  [OK]   mysqldump and gzip on the server" \
      || { echo "  [FAIL] mysqldump or gzip missing on the server"; ok=1; }
  else
    echo "  [--]   no db, database pull not configured"
  fi

  if [ -n "$FILES" ]; then
    remote "command -v rsync >/dev/null" \
      && echo "  [OK]   rsync on the server" \
      || { echo "  [FAIL] rsync missing on the server"; ok=1; }
    for path in $FILES; do
      path="${path%/}"
      if is_safe_path "$path" && [ -n "$REMOTE_ROOT" ] && remote "test -d $REMOTE_ROOT/$path/"; then
        echo "  [OK]   $REMOTE_ROOT/$path"
      else
        echo "  [FAIL] $REMOTE_ROOT/$path not found on the server"
        ok=1
      fi
    done
  else
    echo "  [--]   no files, file pull not configured"
  fi
  return $ok
}

usage() {
  cat <<EOF
Usage: remote-pull <action> <source>

Actions of the providers (ddev pull <source>): info, auth, db, import, files
Actions of "ddev remote-pull":                 sizes, check, sources
EOF
}

ACTION="${1:-}"
SOURCE="${2:-}"

# names given with "ddev pull --environment", before the config files are read
OVERRIDE_NAMES=""
for __name in $OVERRIDABLE; do
  [ -n "${!__name+x}" ] && OVERRIDE_NAMES="$OVERRIDE_NAMES $__name"
done

case "$ACTION" in
  -h|--help|help|"") usage; exit 0 ;;
  sources)
    load_config
    echo "${SOURCES:-}"
    exit 0
    ;;
esac

[ -n "$SOURCE" ] || { usage >&2; exit 1; }
load_config
load_source

case "$ACTION" in
  info)   describe_source; echo ;;
  auth)
    remote true || die "ssh to $SSH_TARGET failed without a prompt. Check with \"ddev remote-pull check $SOURCE\"; a key with passphrase has to be in the ssh-agent (ssh-add)."
    ;;
  db)     action_db ;;
  import) action_import ;;
  files)  action_files ;;
  sizes)  action_sizes ;;
  check)  action_check ;;
  *)      usage >&2; exit 1 ;;
esac
