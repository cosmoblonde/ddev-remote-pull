#ddev-generated
# Settings of remote-pull. "ddev add-on get" copies this file to .ddev/remote-pull/config once; commit that file,
# updates leave it alone.
#
# Format: "key = value", one [section] per source. Settings before the first section are the defaults of every
# source, a section overrides them. Lists are separated by spaces, values may be quoted. Comments start a line with #
# or ;. The file is only read, never executed. Never put passwords here: the database credentials stay on the server
# (see README).
#
# Personal settings, like your own key, go to .ddev/remote-pull/config.local (same format, ignored by git) or to the
# variable REMOTE_PULL_SSH_KEY in your shell profile.
#
# Check the setup with "ddev remote-pull check", then pull with "ddev pull live" or "ddev pull stage". A section
# needs a provider of the same name in .ddev/providers/; live and stage come with the add-on.

# --- defaults --------------------------------------------------------------------------------------------------------

# Tables pulled as structure only, without rows. A * stands for any characters; patterns without a match are skipped.
# One run: ddev pull live --environment="EMPTY_TABLES=..." replaces the list, "WITH_DATA=..." takes tables back,
# "ALL_DATA=1" pulls everything.
#
# TYPO3:
;empty_tables = cache_* cf_* sys_log sys_history be_sessions fe_sessions
# MODX (prefix modx_):
;empty_tables = modx_session modx_manager_log modx_versionx_* modx_seosuite_url

# Folders relative to the project root, the same on the server and locally. Empty: no files are pulled.
#
# TYPO3:
;files = public/fileadmin
;files_exclude = _processed_ _temp_
# MODX:
;files = site/assets/images site/assets/uploads

# Remove local files that are gone on the server: 1 or 0. One run: --environment="FILES_DELETE=1"
;files_delete = 0

# Back up the local database before the import: 1 or 0. One run: --environment="BACKUP=0"
;backup = 1

# Additional mysqldump options, e.g. --routines (needs the right privileges on the server)
;dump_options =

# Remote dumps and local backups, outside the project and so out of git and Mutagen. Nothing is deleted
# automatically. Only allowed here, before the first section.
;dump_dir = ~/ddev-remote-pull/<project>

# Private key; empty: ssh-agent and ~/.ssh/config decide. A key with passphrase has to be in the ssh-agent, the
# providers cannot ask for it. Usually personal, so better in config.local.
;ssh_key = ~/.ssh/id_ed25519

# --- sources ---------------------------------------------------------------------------------------------------------

[live]
# user@host or a Host of ~/.ssh/config
ssh =
;port = 22
# database on the server; mysql and mysqldump read the credentials from ~/.my.cnf of the server account,
# or from the option file in mysql_defaults (a path on the server)
db =
;mysql_defaults = ~/live.my.cnf
# project root on the server (the release folder or its "current" symlink), base of files
root =

[stage]
ssh =
db =
root =
