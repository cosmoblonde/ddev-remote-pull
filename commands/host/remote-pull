#!/usr/bin/env bash
#ddev-generated
## Description: Check the sources of "ddev pull <source>" or list the table sizes there (remote-pull add-on)
## Usage: remote-pull check [<source>] | sizes <source> | sources
## Example: ddev remote-pull check\nddev remote-pull sizes live

# The pull itself is "ddev pull <source>", this command helps with the setup and the table list.
# Runs on the host and stays compatible with bash 3.2 (macOS).

set -o nounset -o pipefail

WORKER="${DDEV_APPROOT:?}/.ddev/remote-pull/remote-pull"

usage() {
  cat <<'EOF'
Usage: ddev remote-pull <command>

  check [<source>]   ssh login, database and folders on the server; all sources without <source>
  sizes <source>     tables on the server by size, the ones pulled as structure only marked
  sources            sources, the [sections] of the config

Pulling:
  ddev pull live                    database and files from live (asks first)
  ddev pull live --skip-files       database only
  ddev pull live --skip-db          files only
  ddev pull live --skip-import      only download the dump, change nothing
  ddev pull live -y                 do not ask

One run only, with --environment="NAME=value,NAME=value":
  EMPTY_TABLES=<pattern> ...     tables without rows, replaces empty_tables of the config
  WITH_DATA=<pattern> ...        these tables with rows although empty_tables lists them
  ALL_DATA=1                     all tables with rows
  BACKUP=0                       no backup of the local database
  DRY_RUN=1                      files: show what rsync would change, change nothing
  FILES_DELETE=1                 files: remove local files that are gone on the server

Settings: .ddev/remote-pull/config and config.local, one [section] per source
EOF
}

case "${1:-}" in
  check)
    if [ -n "${2:-}" ]; then
      exec "$WORKER" check "$2"
    fi
    sources="$("$WORKER" sources)" || exit 1
    [ -n "$sources" ] || { echo "No [section] in .ddev/remote-pull/config." >&2; exit 1; }
    rc=0
    for s in $sources; do
      "$WORKER" check "$s" || rc=1
      echo
    done
    exit $rc
    ;;
  sizes)
    [ -n "${2:-}" ] || { usage >&2; exit 1; }
    exec "$WORKER" sizes "$2"
    ;;
  sources)
    exec "$WORKER" sources
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
